+use super::FsStorage;
+use crate::connectors::{ConnectorInfo, ConnectorRegistry, StorageConnector};
+use crate::error::ConnectorResult;
+use crate::models::*;
+use crate::routes::AppState;
+use crate::services::JobManager;
+use crate::Config;
+use async_trait::async_trait;
+use axum::body::{to_bytes, Body};
+use axum::http::{Request, StatusCode};
+use std::sync::Arc;
+use tower::ServiceExt;
+use tower_sessions::{MemoryStore, SessionManagerLayer};
+
+fn fixture() -> (tempfile::TempDir, Arc<FsStorage>) {
+    let root = tempfile::tempdir().unwrap();
+    let storage = Arc::new(FsStorage::new(
+        root.path().join("websites"),
+        "assets".into(),
+    ));
+    (root, storage)
+}
+fn meta(name: &str) -> WebsiteMetaFileContent {
+    serde_json::from_value(serde_json::json!({"name": name, "imageUrl":"keep-preview", "connectorUserSettings":{"fs":{"keep":true}}})).unwrap()
+}
+fn app(storage: Arc<dyn StorageConnector>, root: &std::path::Path) -> axum::Router {
+    let mut registry = ConnectorRegistry::new();
+    registry.register_storage(storage);
+    let state = AppState {
+        config: Arc::new(Config {
+            url: "http://localhost:6805".into(),
+            port: 6805,
+            data_path: root.to_owned(),
+            hosting_path: None,
+            assets_folder: "assets".into(),
+            default_website_id: "default".into(),
+            dashboard_path: None,
+            static_path: None,
+            static_routes: Vec::new(),
+        }),
+        registry: Arc::new(registry),
+        job_manager: JobManager::new(),
+    };
+    axum::Router::new()
+        .nest("/api", crate::routes::api_routes())
+        .with_state(state)
+        .layer(SessionManagerLayer::new(MemoryStore::default()).with_secure(false))
+}
+fn request(method: &str, uri: &str, value: serde_json::Value) -> Request<Body> {
+    Request::builder()
+        .method(method)
+        .uri(uri)
+        .header("Content-Type", "application/json")
+        .body(Body::from(serde_json::to_vec(&value).unwrap()))
+        .unwrap()
+}
+
+#[tokio::test]
+async fn direct_invalid_ids_are_refused_before_any_filesystem_effect_across_all_methods() {
+    let (root, storage) = fixture();
+    storage.init("default").await.unwrap();
+    let outside = root.path().join("outside");
+    std::fs::create_dir(&outside).unwrap();
+    std::fs::write(outside.join("meta.json"), br#"{"name":"outside"}"#).unwrap();
+    std::fs::write(
+        outside.join("sentinel"),
+        b"unchanged public outside fixture",
+    )
+    .unwrap();
+    let session = serde_json::json!({});
+    let long = "x".repeat(129);
+    for id in [
+        "",
+        ".",
+        "..",
+        "../outside",
+        "safe/../outside",
+        "/absolute",
+        outside.to_str().unwrap(),
+        "a\\outside",
+        "%2foutside",
+        "a%252foutside",
+        "white space",
+        ".hidden",
+        long.as_str(),
+    ] {
+        let id = id.to_owned();
+        assert!(storage.read_website(&session, &id).await.is_err());
