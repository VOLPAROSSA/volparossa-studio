+use super::*;
+use std::fs;
+use std::os::unix::fs::{symlink, PermissionsExt};
+
+fn fixture() -> tempfile::TempDir {
+    let root = tempfile::tempdir().unwrap();
+    fs::create_dir(root.path().join("legacy-site")).unwrap();
+    fs::write(root.path().join("legacy-site/meta.json"), br#"{"name":"old","imageUrl":"public-preview","connectorUserSettings":{"fs":{"keep":true}},"future":{"nested":[1,2]}}"#).unwrap();
+    root
+}
+fn no_temporary(root: &std::path::Path) {
+    assert!(fs::read_dir(root).unwrap().all(|entry| !entry
+        .unwrap()
+        .file_name()
+        .to_string_lossy()
+        .starts_with(".meta-")));
+}
+
+#[test]
+fn rename_preserves_known_and_unknown_fields_and_installs_a_private_regular_file() {
+    let root = fixture();
+    let old: serde_json::Value =
+        serde_json::from_slice(&fs::read(root.path().join("legacy-site/meta.json")).unwrap())
+            .unwrap();
+    linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Rename("new name".into()),
+        || {
+            // The owned temporary is already written/fsynced here. Readers
+            // still see the complete old document until the atomic rename.
+            let visible: serde_json::Value = serde_json::from_slice(
+                &fs::read(root.path().join("legacy-site/meta.json")).unwrap(),
+            )
+            .unwrap();
+            assert_eq!(visible, old);
+        },
+    )
+    .unwrap();
+    let path = root.path().join("legacy-site/meta.json");
+    let new: serde_json::Value = serde_json::from_slice(&fs::read(&path).unwrap()).unwrap();
+    assert_eq!(new["name"], "new name");
+    for field in ["imageUrl", "connectorUserSettings", "future"] {
+        assert_eq!(new[field], old[field]);
+    }
+    assert_eq!(
+        fs::metadata(path).unwrap().permissions().mode() & 0o777,
+        0o600
+    );
+    no_temporary(&root.path().join("legacy-site"));
+}
+
+#[test]
+fn name_only_commit_preserves_exact_numeric_tokens_whitespace_and_unknown_fields() {
+    let root = fixture();
+    let path = root.path().join("legacy-site/meta.json");
+    let before = br#"{ "future": {"integer":18446744073709551617,"decimal":0.10000000000000001}, "connectorUserSettings":{"fs":{"integer":18446744073709551617,"decimal":0.10000000000000001}}, "name" : "old", "imageUrl":"keep" }"#;
+    fs::write(&path, before).unwrap();
+    linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Rename("new".into()),
+        || {},
+    )
+    .unwrap();
+    let expected = String::from_utf8(before.to_vec())
+        .unwrap()
+        .replacen("\"old\"", "\"new\"", 1)
+        .into_bytes();
+    assert_eq!(fs::read(&path).unwrap(), expected);
+    no_temporary(&root.path().join("legacy-site"));
+}
+
+#[test]
+fn lossless_name_span_handles_escaped_keys_nested_values_and_refuses_ambiguous_or_oversize_output()
+{
+    let root = fixture();
+    let path = root.path().join("legacy-site/meta.json");
+    for before in [
+        br#"{"name":"old","future":[{"name":"nested","s":"} [ \\ \" ]"},0.10000000000000001]}"#.as_slice(),
+        br#"{"future":[true,null,{"n":18446744073709551617}],"\u006eame":"old","connectorUserSettings":{}}"#.as_slice(),
+        br#"{ "future":false, "imageUrl":null, "name":"old" }"#.as_slice(),
+    ] {
+        fs::write(&path, before).unwrap();
+        let replacement = "new \"quoted\" \\ value";
+        linux::change(root.path(), "legacy-site", Change::Rename(replacement.into()), || {}).unwrap();
+        let encoded = serde_json::to_string(replacement).unwrap();
+        let expected = String::from_utf8(before.to_vec()).unwrap().replacen("\"old\"", &encoded, 1).into_bytes();
+        assert_eq!(fs::read(&path).unwrap(), expected);
+        no_temporary(&root.path().join("legacy-site"));
+    }
+    let duplicate = br#"{"name":"old","\u006eame":"other"}"#;
+    fs::write(&path, duplicate).unwrap();
+    assert!(linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Rename("denied".into()),
+        || {}
+    )
+    .is_err());
+    assert_eq!(fs::read(&path).unwrap(), duplicate);
+    no_temporary(&root.path().join("legacy-site"));
+    let mut large = br#"{"name":"a","future":""#.to_vec();
+    large.extend(std::iter::repeat_n(b'x', MAX_BYTES - large.len() - 2));
+    large.extend_from_slice(b"\"}");
+    assert_eq!(large.len(), MAX_BYTES);
+    fs::write(&path, &large).unwrap();
+    assert!(linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Rename("larger name".into()),
+        || {}
+    )
+    .is_err());
+    assert_eq!(fs::read(&path).unwrap(), large);
+    no_temporary(&root.path().join("legacy-site"));
+}
+
+#[test]
+fn rooted_metadata_refuses_site_root_file_symlinks_hardlinks_and_nonregular_files() {
+    let root = fixture();
+    let outside = fixture();
+    let sentinel = fs::read(outside.path().join("legacy-site/meta.json")).unwrap();
+    symlink(
+        outside.path().join("legacy-site"),
+        root.path().join("alias"),
+    )
+    .unwrap();
+    assert!(linux::change(root.path(), "alias", Change::Rename("denied".into()), || {}).is_err());
+    let link = root.path().join("root-link");
+    symlink(outside.path(), &link).unwrap();
+    assert!(linux::read(&link, "legacy-site").is_err());
+    let meta = root.path().join("legacy-site/meta.json");
+    fs::remove_file(&meta).unwrap();
+    symlink(outside.path().join("legacy-site/meta.json"), &meta).unwrap();
+    assert!(linux::read(root.path(), "legacy-site").is_err());
+    assert!(linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Replace(b"{}".to_vec()),
+        || {}
+    )
+    .is_err());
+    fs::remove_file(&meta).unwrap();
+    fs::hard_link(outside.path().join("legacy-site/meta.json"), &meta).unwrap();
+    assert!(linux::read(root.path(), "legacy-site").is_err());
+    fs::remove_file(&meta).unwrap();
+    fs::create_dir(&meta).unwrap();
+    assert!(linux::read(root.path(), "legacy-site").is_err());
+    assert_eq!(
+        fs::read(outside.path().join("legacy-site/meta.json")).unwrap(),
+        sentinel
+    );
+    no_temporary(&root.path().join("legacy-site"));
+}
+
+#[test]
+fn observed_content_or_directory_mutation_refuses_commit_and_removes_owned_temporary() {
+    let root = fixture();
+    let path = root.path().join("legacy-site/meta.json");
+    assert!(linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Rename("denied".into()),
+        || {
+            fs::write(&path, br#"{"name":"external change"}"#).unwrap();
+        }
+    )
+    .is_err());
+    assert_eq!(fs::read(&path).unwrap(), br#"{"name":"external change"}"#);
+    no_temporary(&root.path().join("legacy-site"));
+
+    let outside = fixture();
+    let sentinel = fs::read(outside.path().join("legacy-site/meta.json")).unwrap();
+    assert!(linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Rename("denied".into()),
+        || {
+            fs::rename(root.path().join("legacy-site"), root.path().join("held")).unwrap();
+            symlink(
+                outside.path().join("legacy-site"),
+                root.path().join("legacy-site"),
+            )
+            .unwrap();
+        }
+    )
+    .is_err());
+    no_temporary(&root.path().join("held"));
+    assert_eq!(
+        fs::read(outside.path().join("legacy-site/meta.json")).unwrap(),
+        sentinel
+    );
+}
+
+#[test]
+fn changed_or_replaced_temporary_is_never_committed_or_mistaken_for_owned_cleanup() {
+    let root = fixture();
+    let directory = root.path().join("legacy-site");
+    let original = fs::read(directory.join("meta.json")).unwrap();
+    assert!(linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Rename("denied".into()),
+        || {
+            let temporary = fs::read_dir(&directory)
+                .unwrap()
+                .map(|e| e.unwrap().path())
+                .find(|p| {
+                    p.file_name()
+                        .unwrap()
+                        .to_string_lossy()
+                        .starts_with(".meta-")
+                })
+                .unwrap();
+            fs::write(temporary, b"changed public fixture").unwrap();
+        }
+    )
+    .is_err());
+    assert_eq!(fs::read(directory.join("meta.json")).unwrap(), original);
+    no_temporary(&directory);
+
+    let outside = tempfile::tempdir().unwrap();
+    let sentinel = outside.path().join("public-sentinel");
+    fs::write(&sentinel, b"outside unchanged").unwrap();
+    let mut replacement = None;
+    // The hook mutates only public fixture paths. A substituted symlink is not
+    // the helper's inode and must remain untouched by owned-temp cleanup.
+    let result = linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Rename("denied".into()),
+        || {
+            let temporary = fs::read_dir(&directory)
+                .unwrap()
+                .map(|e| e.unwrap().path())
+                .find(|p| {
+                    p.file_name()
+                        .unwrap()
+                        .to_string_lossy()
+                        .starts_with(".meta-")
+                })
+                .unwrap();
+            fs::remove_file(&temporary).unwrap();
+            symlink(&sentinel, &temporary).unwrap();
+            replacement = Some(temporary);
+        },
+    );
+    assert!(result.is_err());
+    assert_eq!(fs::read(directory.join("meta.json")).unwrap(), original);
+    assert_eq!(fs::read(&sentinel).unwrap(), b"outside unchanged");
+    let replacement = replacement.unwrap();
+    assert!(replacement.is_symlink());
+    fs::remove_file(replacement).unwrap();
+    no_temporary(&directory);
+}
+
+#[test]
+fn metadata_limits_duplicate_members_missing_targets_and_name_limits_fail_closed() {
+    let root = fixture();
+    let path = root.path().join("legacy-site/meta.json");
+    for bytes in [
+        vec![b' '; MAX_BYTES + 1],
+        br#"{"name":"a","name":"b"}"#.to_vec(),
+        br#"{"name":"a","future":{"key":1,"key":2}}"#.to_vec(),
+        b"[]".to_vec(),
+    ] {
+        fs::write(&path, bytes).unwrap();
+        assert!(linux::change(
+            root.path(),
+            "legacy-site",
+            Change::Rename("new".into()),
+            || {}
+        )
+        .is_err());
+        no_temporary(&root.path().join("legacy-site"));
+    }
+    for value in [
+        "".to_owned(),
+        " \t".to_owned(),
+        "a\nb".to_owned(),
+        "x".repeat(129),
+        "界".repeat(129),
+    ] {
+        assert!(name(&value).is_err());
+    }
+    assert!(name(&"🦊".repeat(128)).is_ok());
+    assert!(name(&"x".repeat(128)).is_ok());
+    fs::remove_file(&path).unwrap();
+    assert!(linux::change(
+        root.path(),
+        "legacy-site",
+        Change::Rename("missing".into()),
+        || {}
+    )
+    .is_err());
+    assert!(!path.exists());
+    no_temporary(&root.path().join("legacy-site"));
+}
+
+#[tokio::test]
+async fn cancelled_caller_keeps_the_single_metadata_permit_until_blocking_work_finishes() {
+    let lock = Arc::new(Mutex::new(()));
+    let (entered_tx, entered_rx) = tokio::sync::oneshot::channel();
+    let (release_tx, release_rx) = std::sync::mpsc::sync_channel(1);
+    let worker_lock = Arc::clone(&lock);
+    let caller = tokio::spawn(async move {
+        run(worker_lock, move || {
+            entered_tx.send(()).unwrap();
+            release_rx
+                .recv_timeout(std::time::Duration::from_secs(5))
+                .unwrap();
+            Ok(())
+        })
+        .await
+    });
+    entered_rx.await.unwrap();
+    caller.abort();
+    assert!(run(Arc::clone(&lock), || Ok(())).await.is_err());
+    release_tx.send(()).unwrap();
+    tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        loop {
+            if let Ok(guard) = Arc::clone(&lock).try_lock_owned() {
+                drop(guard);
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    run(lock, || Ok(())).await.unwrap();
+}
