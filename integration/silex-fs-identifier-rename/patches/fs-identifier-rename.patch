+/// Explicit name-only mutation; legacy POST /meta remains full replacement.
+async fn rename_website(
+    State(state): State<AppState>,
+    session: Session,
+    Query(query): Query<WebsiteWriteQuery>,
+    Json(request): Json<RenameWebsiteRequest>,
+) -> ConnectorResult<Json<MessageResponse>> {
+    let session_data = get_session_data(&session).await;
+    let connector =
+        get_storage_connector(&state, &session_data, query.connector_id.as_deref()).await?;
+    if !connector.supports_website_rename() {
+        return Err(ConnectorError::InvalidInput(
+            "name-only website rename unsupported".to_owned(),
+        ));
+    }
+    connector
+        .rename_website(&session_data, &query.website_id, &request.name)
+        .await?;
+    Ok(Json(MessageResponse {
+        message: "Website renamed".to_owned(),
     }))
 }
 
