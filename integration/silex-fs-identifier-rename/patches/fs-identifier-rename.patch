+/*
+ * Silex website builder - filesystem website identifier boundary.
+ * Copyright (c) 2026 VOLPAROSSA contributors
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+use crate::error::{ConnectorError, ConnectorResult};
+
+/// Same single-component policy as bounded publication reads. This is specific
+/// to FsStorage: other connectors retain their own identifier namespaces.
+pub(super) fn validate(value: &str) -> ConnectorResult<()> {
+    if value.is_empty()
+        || value.len() > 128
+        || value.starts_with('.')
+        || value.contains('/')
+        || value.chars().any(|c| {
+            c.is_control() || c.is_whitespace() || matches!(c, '\\' | '%' | '?' | '#' | ':')
+        })
+    {
+        return Err(ConnectorError::InvalidInput(
+            "invalid filesystem website identifier".to_owned(),
+        ));
+    }
+    Ok(())
+}
diff --git a/server-rust/src/connectors/fs_storage/metadata.rs b/server-rust/src/connectors/fs_storage/metadata.rs
new file mode 100644
--- /dev/null
+++ b/server-rust/src/connectors/fs_storage/metadata.rs
@@ -0,0 +1,512 @@
+/*
+ * Silex website builder - rooted metadata operations.
+ * Copyright (c) 2026 VOLPAROSSA contributors
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+//! Serializes cooperative metadata operations on one FsStorage instance.
+//! Legacy full replacement remains explicit; this is neither cross-process CAS
+//! nor protection against a later stale full replacement. Additional-platform
+//! rooted backends remain open; no unsafe non-Linux fallback is provided.
+use super::identifier;
+use crate::error::{ConnectorError, ConnectorResult};
+use crate::models::WebsiteMetaFileContent;
+use std::path::PathBuf;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+
+#[cfg(all(test, target_os = "linux"))]
+mod tests;
+
+pub(super) const MAX_BYTES: usize = 256 * 1024;
+
+fn invalid() -> ConnectorError {
+    ConnectorError::InvalidInput("filesystem metadata operation rejected".to_owned())
+}
+
+pub(super) fn name(value: &str) -> ConnectorResult<()> {
+    if value.trim().is_empty()
+        || value.len() > 512
+        || value.chars().count() > 128
+        || value.chars().any(char::is_control)
+    {
+        return Err(invalid());
+    }
+    Ok(())
+}
+
+pub(super) struct Snapshot {
+    pub content: WebsiteMetaFileContent,
+    pub directory: std::fs::Metadata,
+    pub has_public: bool,
+}
+
+pub(super) enum Change {
+    Replace(Vec<u8>),
+    Rename(String),
+}
+
+/// There is at most one admitted metadata job and no waiter queue. The owned
+/// guard lives inside the blocking job, not its cancellable async JoinHandle.
+async fn run<T, F>(lock: Arc<Mutex<()>>, work: F) -> ConnectorResult<T>
+where
+    T: Send + 'static,
+    F: FnOnce() -> ConnectorResult<T> + Send + 'static,
+{
+    let guard = lock
+        .try_lock_owned()
+        .map_err(|_| ConnectorError::InvalidInput("filesystem metadata busy".to_owned()))?;
+    tokio::task::spawn_blocking(move || {
+        let _guard = guard;
+        work()
+    })
+    .await
+    .map_err(|_| invalid())?
+}
+
+pub(super) async fn read(
+    root: PathBuf,
+    id: String,
+    lock: Arc<Mutex<()>>,
+) -> ConnectorResult<Snapshot> {
+    identifier::validate(&id)?;
+    #[cfg(target_os = "linux")]
+    {
+        run(lock, move || linux::read(&root, &id)).await
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = (root, lock);
+        Err(invalid())
+    }
+}
+
+pub(super) async fn change(
+    root: PathBuf,
+    id: String,
+    change: Change,
+    lock: Arc<Mutex<()>>,
+) -> ConnectorResult<()> {
+    identifier::validate(&id)?;
+    match &change {
+        Change::Replace(bytes) if bytes.len() > MAX_BYTES => return Err(invalid()),
+        Change::Rename(value) => name(value)?,
+        Change::Replace(_) => {}
+    }
+    #[cfg(target_os = "linux")]
+    {
+        run(lock, move || linux::change(&root, &id, change, || {})).await
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = (root, change, lock);
+        Err(invalid())
+    }
+}
+
+/// Reject duplicate object members at every level; a name-only change must not
+/// silently discard an ambiguous setting or an unknown future metadata field.
+struct Unique(serde_json::Value);
+impl<'de> serde::Deserialize<'de> for Unique {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct Visitor;
+        impl<'de> serde::de::Visitor<'de> for Visitor {
+            type Value = Unique;
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("unambiguous JSON")
+            }
+            fn visit_bool<E: serde::de::Error>(self, v: bool) -> Result<Unique, E> {
+                Ok(Unique(v.into()))
+            }
+            fn visit_i64<E: serde::de::Error>(self, v: i64) -> Result<Unique, E> {
+                Ok(Unique(v.into()))
+            }
+            fn visit_u64<E: serde::de::Error>(self, v: u64) -> Result<Unique, E> {
+                Ok(Unique(v.into()))
+            }
+            fn visit_f64<E: serde::de::Error>(self, v: f64) -> Result<Unique, E> {
+                serde_json::Number::from_f64(v)
+                    .map(|n| Unique(n.into()))
+                    .ok_or_else(|| E::custom("invalid number"))
+            }
+            fn visit_str<E: serde::de::Error>(self, v: &str) -> Result<Unique, E> {
+                Ok(Unique(v.into()))
+            }
+            fn visit_string<E: serde::de::Error>(self, v: String) -> Result<Unique, E> {
+                Ok(Unique(v.into()))
+            }
+            fn visit_unit<E: serde::de::Error>(self) -> Result<Unique, E> {
+                Ok(Unique(serde_json::Value::Null))
+            }
+            fn visit_seq<A: serde::de::SeqAccess<'de>>(
+                self,
+                mut seq: A,
+            ) -> Result<Unique, A::Error> {
+                let mut values = Vec::new();
+                while let Some(value) = seq.next_element::<Unique>()? {
+                    values.push(value.0);
+                }
+                Ok(Unique(values.into()))
+            }
+            fn visit_map<A: serde::de::MapAccess<'de>>(
+                self,
+                mut map: A,
+            ) -> Result<Unique, A::Error> {
+                let mut values = serde_json::Map::new();
+                while let Some(key) = map.next_key::<String>()? {
+                    if values.contains_key(&key) {
+                        return Err(serde::de::Error::custom("duplicate metadata member"));
+                    }
+                    values.insert(key, map.next_value::<Unique>()?.0);
+                }
+                Ok(Unique(values.into()))
+            }
+        }
+        deserializer.deserialize_any(Visitor)
+    }
+}
+
+fn document(bytes: &[u8]) -> ConnectorResult<serde_json::Value> {
+    if bytes.len() > MAX_BYTES {
+        return Err(invalid());
+    }
+    let Unique(value) = serde_json::from_slice(bytes).map_err(|_| invalid())?;
+    // Validate the existing known schema while retaining unknown fields.
+    let _: WebsiteMetaFileContent = serde_json::from_value(value.clone()).map_err(|_| invalid())?;
+    Ok(value)
+}
+
+fn whitespace(bytes: &[u8], mut offset: usize) -> usize {
+    while bytes.get(offset).is_some_and(u8::is_ascii_whitespace) {
+        offset += 1;
+    }
+    offset
+}
+
+/// These scanners run only AFTER strict duplicate/schema JSON validation. They
+/// locate byte spans and never interpret or reserialize untouched values.
+fn quoted_end(bytes: &[u8], start: usize) -> ConnectorResult<usize> {
+    if bytes.get(start) != Some(&b'"') {
+        return Err(invalid());
+    }
+    let mut offset = start + 1;
+    while let Some(byte) = bytes.get(offset) {
+        match byte {
+            b'\\' => offset += 2,
+            b'"' => return Ok(offset + 1),
+            _ => offset += 1,
+        }
+    }
+    Err(invalid())
+}
+
+fn value_end(bytes: &[u8], start: usize) -> ConnectorResult<usize> {
+    if bytes.get(start) == Some(&b'"') {
+        return quoted_end(bytes, start);
+    }
+    let mut depth = 0;
+    let mut offset = start;
+    while let Some(byte) = bytes.get(offset) {
+        match byte {
+            b'"' => {
+                offset = quoted_end(bytes, offset)?;
+                continue;
+            }
+            b'[' | b'{' => depth += 1,
+            b']' | b'}' if depth > 0 => {
+                depth -= 1;
+                if depth == 0 {
+                    return Ok(offset + 1);
+                }
+            }
+            b',' | b'}' | b' ' | b'\t' | b'\r' | b'\n' if depth == 0 => return Ok(offset),
+            _ => {}
+        }
+        offset += 1;
+    }
+    Err(invalid())
+}
+
+/// Replace ONLY the top-level name string value. In particular, the JSON
+/// validator's f64 representation is never used to persist a number token.
+fn renamed_bytes(bytes: &[u8], replacement: &str) -> ConnectorResult<Vec<u8>> {
+    name(replacement)?;
+    document(bytes)?;
+    let mut offset = whitespace(bytes, 0);
+    if bytes.get(offset) != Some(&b'{') {
+        return Err(invalid());
+    }
+    offset = whitespace(bytes, offset + 1);
+    loop {
+        let key_end = quoted_end(bytes, offset)?;
+        let key: String = serde_json::from_slice(&bytes[offset..key_end]).map_err(|_| invalid())?;
+        offset = whitespace(bytes, key_end);
+        if bytes.get(offset) != Some(&b':') {
+            return Err(invalid());
+        }
+        let start = whitespace(bytes, offset + 1);
+        let end = value_end(bytes, start)?;
+        if key == "name" {
+            if bytes.get(start) != Some(&b'"') {
+                return Err(invalid());
+            }
+            let encoded = serde_json::to_vec(replacement).map_err(|_| invalid())?;
+            let length = bytes
+                .len()
+                .checked_sub(end - start)
+                .and_then(|n| n.checked_add(encoded.len()))
+                .filter(|n| *n <= MAX_BYTES)
+                .ok_or_else(invalid)?;
+            let mut result = Vec::new();
+            result.try_reserve_exact(length).map_err(|_| invalid())?;
+            result.extend_from_slice(&bytes[..start]);
+            result.extend_from_slice(&encoded);
+            result.extend_from_slice(&bytes[end..]);
+            return Ok(result);
+        }
+        offset = whitespace(bytes, end);
+        if bytes.get(offset) != Some(&b',') {
+            return Err(invalid());
+        }
+        offset = whitespace(bytes, offset + 1);
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub(super) mod linux {
+    use super::*;
+    use rustix::fs::{
+        fchmod, openat2, renameat, unlinkat, AtFlags, Mode, OFlags, ResolveFlags, CWD,
+    };
+    use std::fs::{File, Metadata};
+    use std::io::{Read, Write};
+    use std::os::unix::fs::MetadataExt;
+    use std::path::Path;
+
+    fn flags() -> OFlags {
+        OFlags::RDONLY | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::NONBLOCK | OFlags::CLOEXEC
+    }
+    fn resolve() -> ResolveFlags {
+        ResolveFlags::BENEATH | ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS
+    }
+    fn identity(m: &Metadata) -> [i128; 11] {
+        [
+            i128::from(m.dev()),
+            i128::from(m.ino()),
+            i128::from(m.mode()),
+            i128::from(m.uid()),
+            i128::from(m.gid()),
+            i128::from(m.nlink()),
+            i128::from(m.len()),
+            i128::from(m.mtime()),
+            i128::from(m.mtime_nsec()),
+            i128::from(m.ctime()),
+            i128::from(m.ctime_nsec()),
+        ]
+    }
+    struct Rooted {
+        root: File,
+        site: File,
+        id: String,
+    }
+    impl Rooted {
+        fn open(root: &Path, id: &str) -> ConnectorResult<Self> {
+            identifier::validate(id)?;
+            let root = File::from(
+                openat2(
+                    CWD,
+                    root,
+                    flags(),
+                    Mode::empty(),
+                    ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS,
+                )
+                .map_err(|_| invalid())?,
+            );
+            let site = File::from(
+                openat2(&root, id, flags(), Mode::empty(), resolve()).map_err(|_| invalid())?,
+            );
+            Ok(Self {
+                root,
+                site,
+                id: id.to_owned(),
+            })
+        }
+        fn same_site(&self) -> ConnectorResult<()> {
+            let current = File::from(
+                openat2(
+                    &self.root,
+                    self.id.as_str(),
+                    flags(),
+                    Mode::empty(),
+                    resolve(),
+                )
+                .map_err(|_| invalid())?,
+            );
+            let before = self.site.metadata()?;
+            let after = current.metadata()?;
+            if (before.dev(), before.ino()) != (after.dev(), after.ino()) {
+                return Err(invalid());
+            }
+            Ok(())
+        }
+        fn current(&self) -> ConnectorResult<Option<Current>> {
+            let descriptor = match openat2(
+                &self.site,
+                "meta.json",
+                OFlags::RDONLY | OFlags::NOFOLLOW | OFlags::NONBLOCK | OFlags::CLOEXEC,
+                Mode::empty(),
+                resolve(),
+            ) {
+                Ok(fd) => fd,
+                Err(rustix::io::Errno::NOENT) => return Ok(None),
+                Err(_) => return Err(invalid()),
+            };
+            let mut file = File::from(descriptor);
+            let before = file.metadata()?;
+            if !before.is_file() || before.nlink() != 1 || before.len() > MAX_BYTES as u64 {
+                return Err(invalid());
+            }
+            let mut bytes =
+                Vec::with_capacity(usize::try_from(before.len()).map_err(|_| invalid())?);
+            Read::by_ref(&mut file)
+                .take((MAX_BYTES + 1) as u64)
+                .read_to_end(&mut bytes)?;
+            if bytes.len() != usize::try_from(before.len()).map_err(|_| invalid())?
+                || identity(&before) != identity(&file.metadata()?)
+            {
+                return Err(invalid());
+            }
+            Ok(Some(Current {
+                file,
+                before,
+                bytes,
+            }))
+        }
+    }
+    struct Current {
+        file: File,
+        before: Metadata,
+        bytes: Vec<u8>,
+    }
+    struct Pending<'a> {
+        site: &'a File,
+        name: String,
+        identity: (u64, u64),
+        armed: bool,
+    }
+    impl Drop for Pending<'_> {
+        fn drop(&mut self) {
+            if self.armed {
+                // A replaced name is no longer our owned temporary. Never
+                // follow or remove that replacement during error cleanup.
+                if let Ok(fd) = openat2(
+                    self.site,
+                    self.name.as_str(),
+                    OFlags::PATH | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+                    Mode::empty(),
+                    resolve(),
+                ) {
+                    if let Ok(info) = File::from(fd).metadata() {
+                        if (info.dev(), info.ino()) == self.identity {
+                            let _ = unlinkat(self.site, self.name.as_str(), AtFlags::empty());
+                        }
+                    }
+                }
+            }
+        }
+    }
+    pub(super) fn read(root: &Path, id: &str) -> ConnectorResult<Snapshot> {
+        let rooted = Rooted::open(root, id)?;
+        let current = rooted
+            .current()?
+            .ok_or_else(|| ConnectorError::NotFound("website metadata absent".to_owned()))?;
+        let value = document(&current.bytes)?;
+        rooted.same_site()?;
+        let has_public = openat2(&rooted.site, "public", flags(), Mode::empty(), resolve()).is_ok();
+        Ok(Snapshot {
+            content: serde_json::from_value(value)?,
+            directory: rooted.site.metadata()?,
+            has_public,
+        })
+    }
+    pub(super) fn change<F: FnOnce()>(
+        root: &Path,
+        id: &str,
+        change: Change,
+        before_commit: F,
+    ) -> ConnectorResult<()> {
+        let rooted = Rooted::open(root, id)?;
+        let current = rooted.current()?;
+        let bytes = match change {
+            Change::Replace(bytes) => bytes,
+            Change::Rename(value) => {
+                name(&value)?;
+                let old = current.as_ref().ok_or_else(|| {
+                    ConnectorError::NotFound("website metadata absent".to_owned())
+                })?;
+                renamed_bytes(&old.bytes, &value)?
+            }
+        };
+        if bytes.len() > MAX_BYTES {
+            return Err(invalid());
+        }
+        let temporary = format!(".meta-{}.tmp", uuid::Uuid::new_v4());
+        let descriptor = openat2(
+            &rooted.site,
+            temporary.as_str(),
+            OFlags::WRONLY | OFlags::CREATE | OFlags::EXCL | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::RUSR | Mode::WUSR,
+            resolve(),
+        )
+        .map_err(|_| invalid())?;
+        let mut output = File::from(descriptor);
+        let owned = output.metadata()?;
+        let mut pending = Pending {
+            site: &rooted.site,
+            name: temporary,
+            identity: (owned.dev(), owned.ino()),
+            armed: true,
+        };
+        fchmod(&output, Mode::RUSR | Mode::WUSR).map_err(|_| invalid())?;
+        output.write_all(&bytes)?;
+        output.sync_all()?;
+        let prepared = output.metadata()?;
+        before_commit();
+        rooted.same_site()?;
+        let visible = File::from(
+            openat2(
+                &rooted.site,
+                pending.name.as_str(),
+                OFlags::RDONLY | OFlags::NOFOLLOW | OFlags::NONBLOCK | OFlags::CLOEXEC,
+                Mode::empty(),
+                resolve(),
+            )
+            .map_err(|_| invalid())?,
+        );
+        if identity(&prepared) != identity(&output.metadata()?)
+            || identity(&prepared) != identity(&visible.metadata()?)
+            || prepared.nlink() != 1
+            || prepared.mode() & 0o777 != 0o600
+        {
+            return Err(invalid());
+        }
+        let now = rooted.current()?;
+        match (&current, &now) {
+            (None, None) => {}
+            (Some(before), Some(after))
+                if identity(&before.before) == identity(&before.file.metadata()?)
+                    && identity(&before.before) == identity(&after.before) => {}
+            _ => return Err(invalid()),
+        }
+        renameat(
+            &rooted.site,
+            pending.name.as_str(),
+            &rooted.site,
+            "meta.json",
+        )
+        .map_err(|_| invalid())?;
+        pending.armed = false;
+        rooted.site.sync_all()?;
+        rooted.same_site()?;
+        Ok(())
+    }
+}
