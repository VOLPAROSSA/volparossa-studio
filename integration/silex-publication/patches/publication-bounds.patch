+fn app(
+    probe: Arc<Probe>,
+    storage: Option<Arc<dyn StorageConnector>>,
+    maximum_body: usize,
+) -> Router {
+    let mut registry = ConnectorRegistry::new();
+    registry.register_storage(storage.unwrap_or_else(|| probe.clone()));
+    registry.register_hosting(probe);
+    let state = AppState {
+        config: Arc::new(Config {
+            url: "http://localhost:6805".into(),
+            port: 6805,
+            data_path: "/unused".into(),
+            hosting_path: None,
+            assets_folder: "assets".into(),
+            default_website_id: "default".into(),
+            dashboard_path: None,
+            static_path: None,
+            static_routes: Vec::new(),
+        }),
+        registry: Arc::new(registry),
+        job_manager: JobManager::new(),
+    };
+    bounded_routes(maximum_body)
+        .with_state(state)
+        .layer(SessionManagerLayer::new(MemoryStore::default()).with_secure(false))
+}
+fn post_body(value: serde_json::Value) -> Request<Body> {
+    Request::builder()
+        .method("POST")
+        .uri("/?websiteId=default&hostingId=fixture")
+        .header("Content-Type", "application/json")
+        .body(Body::from(serde_json::to_vec(&value).unwrap()))
+        .unwrap()
