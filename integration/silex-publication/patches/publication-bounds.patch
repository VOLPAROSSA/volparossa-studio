+use super::*;
+use std::sync::{
+    atomic::{AtomicUsize, Ordering},
+    Arc,
+};
+
+fn query() -> PublishQuery {
+    PublishQuery {
+        website_id: "default".into(),
+        hosting_id: "fixture".into(),
+        storage_id: Some("fs-storage".into()),
+    }
+}
+fn file(path: &str, content: Option<&str>, src: Option<&str>) -> ClientSideFile {
+    ClientSideFile {
+        path: path.into(),
+        content: content.map(str::to_owned),
+        src: src.map(str::to_owned),
+    }
+}
+fn deadline() -> std::time::Instant {
+    std::time::Instant::now() + std::time::Duration::from_secs(5)
+}
+fn request(files: Vec<ClientSideFile>) -> PublishRequest {
+    PublishRequest { files }
+}
+fn plan(files: Vec<ClientSideFile>) -> ConnectorResult<Plan> {
+    Plan::new(request(files), &query(), "http://localhost:6805")
+}
+
+#[tokio::test]
+async fn representative_inline_and_stored_revision_preserves_exact_bytes() {
+    let selected = plan(vec![
+        file("index.html", Some("<p>review</p>"), None),
+        file(
+            "/images/a.png",
+            None,
+            Some("/api/website/assets/a.png?websiteId=default&connectorId=fs-storage"),
+        ),
+    ])
+    .unwrap();
+    let mut calls = Vec::new();
+    let result = selected
+        .materialize(deadline(), |name, maximum, _| {
+            calls.push((name, maximum));
+            std::future::ready(Ok(b"stored bytes".to_vec()))
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        (&*result[0].path, &*result[0].content),
+        ("/index.html", b"<p>review</p>".as_slice())
+    );
+    assert_eq!(
+        (&*result[1].path, &*result[1].content),
+        ("/images/a.png", b"stored bytes".as_slice())
+    );
+    assert_eq!(calls[0].0, "a.png");
+    assert!(calls[0].1 < MAX_OBJECT_BYTES - 4 - 12);
+}
+
+#[test]
+fn malformed_late_descriptor_and_count_path_query_limits_fail_before_materialization() {
+    for bad in [
+        file("../private", Some("x"), None),
+        file("/index.html", Some("duplicate"), None),
+        file("late.txt", Some("both"), Some("private")),
+        file("late.txt", None, None),
+        file(
+            "late.txt",
+            None,
+            Some("/api/website/assets/x?websiteId=another"),
+        ),
+    ] {
+        assert!(plan(vec![file("index.html", None, Some("first")), bad]).is_err());
+    }
+    assert!(plan(
+        (0..=MAX_FILES)
+            .map(|i| file(&format!("file{i}"), Some(""), None))
+            .collect()
+    )
+    .is_err());
+    for path in [
+        "",
+        "/",
+        "//index.html",
+        "../x",
+        "a/./x",
+        "a//b",
+        "a\\b",
+        "a%2fb",
+        "a?b",
+        "a#b",
+        ".hidden",
+        "a:stream",
+    ] {
+        assert!(plan(vec![
+            file("index.html", Some(""), None),
+            file(path, Some(""), None)
+        ])
+        .is_err());
+    }
+    assert!(canonical_path(&"x".repeat(MAX_PATH_BYTES)).is_err());
+    assert!(source_path(
+        &"x".repeat(MAX_SOURCE_BYTES + 1),
+        &query(),
+        "http://localhost:6805"
+    )
+    .is_err());
+    assert!(plan(vec![file("not-index.html", Some(""), None)]).is_err());
+    for website in ["../private", "other/site", "", ".", "a%2fb"] {
+        let mut selected = query();
+        selected.website_id = website.into();
+        assert!(Plan::new(
+            request(vec![file("index.html", Some(""), None)]),
+            &selected,
+            "http://localhost:6805"
+        )
+        .is_err());
+    }
+}
