+/*
+ * Silex website builder, free/libre no-code tool for makers.
+ * Copyright (c) 2023 lexoyo and Silex Labs foundation
+ * Copyright (c) 2026 VOLPAROSSA contributors
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+//! Bounded untrusted preparation, before connector or publication authority.
+//! Geometry mirrors Core SiteBundle v1; this module never signs or hosts content.
+
+use std::collections::BTreeSet;
+use std::fmt;
+use std::future::Future;
+use std::time::{Duration, Instant};
+
+use serde::de::{self, SeqAccess, Visitor};
+use serde::Deserializer;
+
+use super::{ClientSideFile, PublishQuery, PublishRequest};
+use crate::error::{ConnectorError, ConnectorResult};
+use crate::models::ConnectorFile;
+
+pub(super) const PREPARATION_SECONDS: u64 = 30;
+pub(super) const MAX_BODY_BYTES: usize = 256 * 1024 * 1024;
+pub(super) const MAX_FILES: usize = 256;
+pub(super) const MAX_PATH_BYTES: usize = 1024;
+const MAX_SOURCE_BYTES: usize = 4096;
+const MAX_IDENTIFIER_BYTES: usize = 128;
+const MAX_INDEX_BYTES: u64 = 256 * 1024;
+const MAX_OBJECT_BYTES: u64 = 256 * 1024 * 1024;
+const MAX_MIME_BYTES: u64 = 128;
+
+pub(super) fn invalid() -> ConnectorError {
+    ConnectorError::InvalidInput("publication preparation rejected".to_owned())
+}
+
+pub(super) fn deserialize_files<'de, D>(deserializer: D) -> Result<Vec<ClientSideFile>, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    struct Files;
+    impl<'de> Visitor<'de> for Files {
+        type Value = Vec<ClientSideFile>;
+        fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+            formatter.write_str("a bounded publication file sequence")
+        }
+        fn visit_seq<A: SeqAccess<'de>>(self, mut sequence: A) -> Result<Self::Value, A::Error> {
+            let mut files = Vec::new();
+            while files.len() < MAX_FILES {
+                let Some(file) = sequence.next_element()? else {
+                    return Ok(files);
+                };
+                files
+                    .try_reserve(1)
+                    .map_err(|_| de::Error::custom("publication allocation limit"))?;
+                files.push(file);
+            }
+            if sequence.next_element::<de::IgnoredAny>()?.is_some() {
+                return Err(de::Error::custom("publication file limit"));
+            }
+            Ok(files)
+        }
+    }
+    deserializer.deserialize_seq(Files)
+}
+
+#[cfg(test)]
+fn decode(bytes: &[u8]) -> ConnectorResult<PublishRequest> {
+    if bytes.len() > MAX_BODY_BYTES {
+        return Err(invalid());
+    }
+    serde_json::from_slice(bytes).map_err(|_| invalid())
+}
+
+pub(crate) fn relative_path(path: &str) -> ConnectorResult<()> {
+    if path.is_empty()
+        || path.len() > MAX_PATH_BYTES
+        || path.starts_with('/')
+        || path.chars().any(|c| {
+            c.is_control() || c.is_whitespace() || matches!(c, '\\' | '%' | '?' | '#' | ':')
+        })
+        || path
+            .split('/')
+            .any(|part| part.is_empty() || part.starts_with('.'))
+    {
+        return Err(invalid());
+    }
+    Ok(())
+}
+
+fn identifier(value: &str) -> ConnectorResult<()> {
+    if value.len() > MAX_IDENTIFIER_BYTES || value.contains('/') {
+        return Err(invalid());
+    }
+    relative_path(value)
+}
+
+fn canonical_path(path: &str) -> ConnectorResult<String> {
+    let relative = path.strip_prefix('/').unwrap_or(path);
+    relative_path(relative)?;
+    if relative.len() + 1 > MAX_PATH_BYTES {
+        return Err(invalid());
+    }
+    Ok(format!("/{relative}"))
+}
+
+fn source_path(source: &str, query: &PublishQuery, origin: &str) -> ConnectorResult<String> {
+    if source.len() > MAX_SOURCE_BYTES || source.chars().any(char::is_control) {
+        return Err(invalid());
+    }
+    let local = if source.starts_with("http://") || source.starts_with("https://") {
+        // Exact operator-configured origin only. Never fetch the supplied URL or
+        // silently reinterpret another origin as permission to read local assets.
+        let authority = origin
+            .strip_prefix("http://")
+            .or_else(|| origin.strip_prefix("https://"))
+            .ok_or_else(invalid)?;
+        if authority.is_empty()
+            || authority
+                .chars()
+                .any(|c| c.is_whitespace() || matches!(c, '/' | '?' | '#' | '@' | '%' | '\\'))
+        {
+            return Err(invalid());
+        }
+        source
+            .strip_prefix(origin)
+            .filter(|rest| rest.starts_with("/api/website/assets/"))
+            .ok_or_else(invalid)?
+    } else {
+        source
+    };
+    let relative = if let Some(api) = local.strip_prefix("/api/website/assets/") {
+        let (name, parameters) = api
+            .split_once('?')
+            .map_or((api, None), |(name, parameters)| (name, Some(parameters)));
+        if let Some(parameters) = parameters {
+            let mut seen = BTreeSet::new();
+            for pair in parameters.split('&') {
+                let (key, value) = pair.split_once('=').ok_or_else(invalid)?;
+                if !seen.insert(key) {
+                    return Err(invalid());
+                }
+                match key {
+                    "websiteId" if value == query.website_id => {}
+                    "connectorId" if query.storage_id.as_deref() == Some(value) => {}
+                    _ => return Err(invalid()),
+                }
+            }
+            // A query-bearing API reference must bind its website explicitly.
+            if !seen.contains("websiteId") {
+                return Err(invalid());
+            }
+        }
+        name
+    } else if let Some(name) = local.strip_prefix("/assets/") {
+        name
+    } else {
+        local
+    };
+    relative_path(relative)?;
+    Ok(relative.to_owned())
+}
+
+fn varint_bytes(mut value: u64) -> u64 {
+    let mut bytes = 1;
+    while value >= 128 {
+        value >>= 7;
+        bytes += 1;
+    }
+    bytes
+}
+
+fn add(left: u64, right: u64) -> ConnectorResult<u64> {
+    left.checked_add(right).ok_or_else(invalid)
+}
+
+fn index_reservation(paths: impl Iterator<Item = usize>) -> ConnectorResult<u64> {
+    // prost Index: version=1 is two bytes. Each Entry has path field 1,
+    // MIME field 2 (at most 128 bytes), and u64 offset/length fields 3/4.
+    // Reserve ten-byte u64 varints even for absent/default fields. The Entry's
+    // enclosing field-2 tag and length varint are also included. Thus this is
+    // an upper bound independent of asset sizes, not a guessed payload margin.
+    let mut index = 2;
+    for length in paths {
+        let path = u64::try_from(length).map_err(|_| invalid())?;
+        let entry = add(
+            add(
+                add(1 + varint_bytes(path), path)?,
+                1 + varint_bytes(MAX_MIME_BYTES) + MAX_MIME_BYTES,
+            )?,
+            22,
+        )?;
+        index = add(index, add(1 + varint_bytes(entry), entry)?)?;
+        if index > MAX_INDEX_BYTES {
+            return Err(invalid());
+        }
+    }
+    Ok(index)
+}
+
+fn remaining_payload(index: u64, inline: u64) -> ConnectorResult<u64> {
+    let reserved = add(4, index)?;
+    MAX_OBJECT_BYTES
+        .checked_sub(add(reserved, inline)?)
+        .ok_or_else(invalid)
+}
+
+enum Source {
+    Inline(Vec<u8>),
+    Stored(String),
+}
+struct File {
+    path: String,
+    source: Source,
+}
+
+pub(super) struct Plan {
+    files: Vec<File>,
+    stored_budget: u64,
+}
+
+impl Plan {
+    pub(super) fn new(
+        request: PublishRequest,
+        query: &PublishQuery,
+        origin: &str,
+    ) -> ConnectorResult<Self> {
+        identifier(&query.website_id)?;
+        identifier(&query.hosting_id)?;
+        if let Some(id) = &query.storage_id {
+            identifier(id)?;
+        }
+        if request.files.is_empty() || request.files.len() > MAX_FILES {
+            return Err(invalid());
+        }
+        let mut files = Vec::new();
+        files
+            .try_reserve_exact(request.files.len())
+            .map_err(|_| invalid())?;
+        let mut paths = BTreeSet::new();
+        let mut inline = 0;
+        for file in request.files {
+            let path = canonical_path(&file.path)?;
+            if !paths.insert(path.clone()) {
+                return Err(invalid());
+            }
+            let source = match (file.content, file.src) {
+                (Some(content), None) => {
+                    inline = add(inline, u64::try_from(content.len()).map_err(|_| invalid())?)?;
+                    if inline > MAX_OBJECT_BYTES {
+                        return Err(invalid());
+                    }
+                    Source::Inline(content.into_bytes())
+                }
+                (None, Some(source)) => Source::Stored(source_path(&source, query, origin)?),
+                _ => return Err(invalid()),
+            };
+            files.push(File { path, source });
+        }
+        if !paths.contains("/index.html") {
+            return Err(invalid());
+        }
+        let stored_budget = remaining_payload(
+            index_reservation(files.iter().map(|file| file.path.len()))?,
+            inline,
+        )?;
+        Ok(Self {
+            files,
+            stored_budget,
+        })
+    }
+
+    pub(super) async fn materialize<F, Fut>(
+        self,
+        deadline: Instant,
+        mut read: F,
+    ) -> ConnectorResult<Vec<ConnectorFile>>
+    where
+        F: FnMut(String, u64, Instant) -> Fut,
+        Fut: Future<Output = ConnectorResult<Vec<u8>>>,
+    {
+        if Instant::now() >= deadline
+            || deadline > Instant::now() + Duration::from_secs(PREPARATION_SECONDS)
+        {
+            return Err(invalid());
+        }
+        let operation = async move {
+            let mut budget = self.stored_budget;
+            let mut output = Vec::new();
+            output
+                .try_reserve_exact(self.files.len())
+                .map_err(|_| invalid())?;
+            for file in self.files {
+                if Instant::now() >= deadline {
+                    return Err(invalid());
+                }
+                let content = match file.source {
+                    Source::Inline(bytes) => bytes,
+                    Source::Stored(name) => {
+                        let bytes = read(name, budget, deadline).await?;
+                        // Defensive contract check; production bounded Storage must enforce
+                        // this budget before allocating/reading, not merely return a Vec.
+                        budget = budget
+                            .checked_sub(u64::try_from(bytes.len()).map_err(|_| invalid())?)
+                            .ok_or_else(invalid)?;
+                        bytes
+                    }
+                };
+                output.push(ConnectorFile {
+                    path: file.path,
+                    content,
+                });
+            }
+            if Instant::now() >= deadline {
+                return Err(invalid());
+            }
+            Ok(output)
+        };
+        tokio::time::timeout_at(tokio::time::Instant::from_std(deadline), operation)
+            .await
+            .map_err(|_| invalid())?
+    }
+}
+
+#[cfg(test)]
+mod tests;
