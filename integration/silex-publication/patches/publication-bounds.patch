+//! Linux publication capability. Rooting grants no ownership/publication consent.
+//! At most two jobs per connector hold FDs/allocated asset bytes. Cancellation is
+//! cooperative: a kernel-stalled job retains its permit until it actually exits.
+//! Caller cancellation/timeout cannot authorize hosting or prove shutdown drainage.
+
+use crate::error::{ConnectorError, ConnectorResult};
+use std::path::Path;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+use std::time::{Duration, Instant};
+use tokio::sync::Semaphore;
+
+fn invalid() -> ConnectorError {
+    ConnectorError::InvalidInput("bounded publication asset read rejected".to_owned())
+}
+fn relative(path: &str) -> ConnectorResult<()> {
+    if path.is_empty()
+        || path.len() > 1024
+        || path.starts_with('/')
+        || path.chars().any(|c| {
+            c.is_control() || c.is_whitespace() || matches!(c, '\\' | '%' | '?' | '#' | ':')
+        })
+        || path
+            .split('/')
+            .any(|part| part.is_empty() || part.starts_with('.'))
+    {
+        return Err(invalid());
+    }
+    Ok(())
+}
+fn check(deadline: Instant, cancelled: &AtomicBool) -> ConnectorResult<()> {
+    if cancelled.load(Ordering::Acquire) || Instant::now() >= deadline {
+        return Err(invalid());
+    }
+    Ok(())
+}
+struct Cancel(Arc<AtomicBool>);
+impl Drop for Cancel {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::Release);
+    }
+}
+
+async fn run<F>(capacity: Arc<Semaphore>, deadline: Instant, work: F) -> ConnectorResult<Vec<u8>>
+where
+    F: FnOnce(Instant, Arc<AtomicBool>) -> ConnectorResult<Vec<u8>> + Send + 'static,
+{
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let _cancel = Cancel(Arc::clone(&cancelled));
+    let end = tokio::time::Instant::from_std(deadline);
+    let permit = tokio::time::timeout_at(end, capacity.acquire_owned())
+        .await
+        .map_err(|_| invalid())?
+        .map_err(|_| invalid())?;
+    check(deadline, &cancelled)?;
+    let job = tokio::task::spawn_blocking(move || {
+        let _permit = permit;
+        check(deadline, &cancelled)?;
+        work(deadline, cancelled)
+    });
+    let result = tokio::time::timeout_at(end, job)
+        .await
+        .map_err(|_| invalid())?
+        .map_err(|_| invalid())??;
+    check(deadline, &_cancel.0)?;
+    Ok(result)
+}
+
+#[cfg(target_os = "linux")]
+mod linux {
+    use super::*;
+    use rustix::fs::{openat2, Mode, OFlags, ResolveFlags, CWD};
+    use std::fs::{File, Metadata};
+    use std::io::Read;
+    use std::os::unix::fs::MetadataExt;
+
+    fn identity(meta: &Metadata) -> (u64, u64, u32, u32, u32, u64, u64, i64, i64, i64, i64) {
+        (
+            meta.dev(),
+            meta.ino(),
+            meta.mode(),
+            meta.uid(),
+            meta.gid(),
+            meta.nlink(),
+            meta.len(),
+            meta.mtime(),
+            meta.mtime_nsec(),
+            meta.ctime(),
+            meta.ctime_nsec(),
+        )
+    }
+    pub(super) struct Opened {
+        file: File,
+        before: Metadata,
+    }
+    impl Opened {
+        pub(super) fn capture(file: File, maximum: u64) -> ConnectorResult<Self> {
+            let before = file.metadata().map_err(|_| invalid())?;
+            if !before.is_file()
+                || before.nlink() != 1
+                || before.len() > maximum
+                || maximum > 256 * 1024 * 1024
+            {
+                return Err(invalid());
+            }
+            Ok(Self { file, before })
+        }
+        pub(super) fn read(
+            mut self,
+            deadline: Instant,
+            cancelled: &AtomicBool,
+        ) -> ConnectorResult<Vec<u8>> {
+            check(deadline, cancelled)?;
+            let length = usize::try_from(self.before.len()).map_err(|_| invalid())?;
+            let mut bytes = Vec::new();
+            bytes.try_reserve_exact(length).map_err(|_| invalid())?;
+            let mut buffer = [0_u8; 16384];
+            while bytes.len() < length {
+                check(deadline, cancelled)?;
+                let count = (length - bytes.len()).min(buffer.len());
+                let read = self
+                    .file
+                    .read(&mut buffer[..count])
+                    .map_err(|_| invalid())?;
+                check(deadline, cancelled)?;
+                if read == 0 {
+                    return Err(invalid());
+                }
+                bytes.extend_from_slice(&buffer[..read]);
+            }
+            check(deadline, cancelled)?;
+            let mut extra = [0_u8; 1];
+            let additional = self.file.read(&mut extra).map_err(|_| invalid())?;
+            check(deadline, cancelled)?;
+            if additional != 0
+                || identity(&self.file.metadata().map_err(|_| invalid())?) != identity(&self.before)
+            {
+                return Err(invalid());
+            }
+            check(deadline, cancelled)?;
+            Ok(bytes)
+        }
+    }
+    fn open(root: &Path, assets: &str, website: &str, name: &str) -> ConnectorResult<File> {
+        relative(website)?;
+        if website.contains('/') || website.len() > 128 {
+            return Err(invalid());
+        }
+        relative(assets)?;
+        relative(name)?;
+        let flags = OFlags::RDONLY
+            | OFlags::DIRECTORY
+            | OFlags::NOFOLLOW
+            | OFlags::CLOEXEC
+            | OFlags::NONBLOCK;
+        let no_links = ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS;
+        // The operator chooses this root. Symlinks in all of its components are
+        // refused. Subsequent resolution stays beneath this owned descriptor.
+        let root = openat2(CWD, root, flags, Mode::empty(), no_links).map_err(|_| invalid())?;
+        let selected = format!("{website}/{assets}");
+        let assets = openat2(
+            &root,
+            selected.as_str(),
+            flags,
+            Mode::empty(),
+            no_links | ResolveFlags::BENEATH,
+        )
+        .map_err(|_| invalid())?;
+        let fd = openat2(
+            &assets,
+            name,
+            OFlags::RDONLY | OFlags::CLOEXEC | OFlags::NOFOLLOW | OFlags::NONBLOCK,
+            Mode::empty(),
+            no_links | ResolveFlags::BENEATH,
+        )
+        .map_err(|_| invalid())?;
+        Ok(File::from(fd))
+    }
+    pub(super) fn read(
+        root: &Path,
+        assets: &str,
+        website: &str,
+        name: &str,
+        maximum: u64,
+        deadline: Instant,
+        cancelled: &AtomicBool,
+    ) -> ConnectorResult<Vec<u8>> {
+        check(deadline, cancelled)?;
+        if maximum > 256 * 1024 * 1024 {
+            return Err(invalid());
+        }
+        let file = open(root, assets, website, name)?;
+        check(deadline, cancelled)?;
+        Opened::capture(file, maximum)?.read(deadline, cancelled)
+    }
+}
+
+pub(super) async fn read(
+    root: &Path,
+    assets: &str,
+    website: &str,
+    name: &str,
+    maximum: u64,
+    deadline: Instant,
+    capacity: Arc<Semaphore>,
+) -> ConnectorResult<Vec<u8>> {
+    #[cfg(target_os = "linux")]
+    {
+        // The caller's original deadline includes queue wait/open/metadata/chunks.
+        if deadline <= Instant::now()
+            || deadline > Instant::now() + Duration::from_secs(30)
+            || maximum > 256 * 1024 * 1024
+        {
+            return Err(invalid());
+        }
+        relative(website)?;
+        relative(assets)?;
+        relative(name)?;
+        if website.contains('/') || website.len() > 128 {
+            return Err(invalid());
+        }
+        let (root, assets, website, name) = (
+            root.to_owned(),
+            assets.to_owned(),
+            website.to_owned(),
+            name.to_owned(),
+        );
+        run(capacity, deadline, move |deadline, cancelled| {
+            linux::read(
+                &root, &assets, &website, &name, maximum, deadline, &cancelled,
+            )
+        })
+        .await
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = (root, assets, website, name, maximum, deadline, capacity);
+        Err(ConnectorError::InvalidInput(
+            "bounded publication filesystem reads require Linux openat2".to_owned(),
+        ))
+    }
+}
+
+#[cfg(all(test, target_os = "linux"))]
+mod tests;
