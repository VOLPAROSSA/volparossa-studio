+    );
+    assert!(index_reservation(std::iter::repeat_n(MAX_PATH_BYTES, MAX_FILES)).is_err());
+    let mut files = vec![file("index.html", Some(""), None)];
+    for i in 0..MAX_FILES - 1 {
+        files.push(file(
+            &format!("{:03}{}", i, "a".repeat(1019)),
+            Some(""),
+            None,
+        ));
+    }
+    assert!(plan(files).is_err());
+    assert!(add(u64::MAX, 1).is_err());
+    assert!(remaining_payload(2, MAX_OBJECT_BYTES).is_err());
+    assert_eq!(remaining_payload(2, MAX_OBJECT_BYTES - 6).unwrap(), 0);
