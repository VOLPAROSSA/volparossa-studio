+    let assets = root.path().join("default/assets");
+    symlink(other.path().join("private"), assets.join("link")).unwrap();
+    symlink(other.path(), assets.join("directory-link")).unwrap();
+    fs::hard_link(other.path().join("private"), assets.join("hardlink")).unwrap();
+    let capacity = Arc::new(Semaphore::new(2));
