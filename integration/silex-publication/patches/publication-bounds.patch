+#[tokio::test]
+async fn all_stored_reads_share_remaining_budget_and_error_stops_later_reads() {
+    let make = || {
+        plan(vec![
+            file("index.html", Some("x"), None),
+            file("a", None, Some("a")),
+            file("b", None, Some("b")),
+        ])
+        .unwrap()
+    };
+    let mut maxima = Vec::new();
+    make()
+        .materialize(deadline(), |_, maximum, _| {
+            maxima.push(maximum);
+            std::future::ready(Ok(vec![1, 2, 3]))
+        })
+        .await
+        .unwrap();
+    assert_eq!(maxima[0] - maxima[1], 3);
+    let mut selected = make();
+    selected.stored_budget = 2;
+    assert!(selected
+        .materialize(deadline(), |_, _, _| std::future::ready(Ok(vec![0; 3])))
+        .await
+        .is_err());
+    let mut reads = 0;
+    assert!(make()
+        .materialize(deadline(), |_, _, _| {
+            reads += 1;
+            std::future::ready(Err(invalid()))
+        })
+        .await
+        .is_err());
+    assert_eq!(reads, 1);
+}
