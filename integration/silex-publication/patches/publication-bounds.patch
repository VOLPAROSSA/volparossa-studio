+async fn actual_route_preserves_inline_and_filesystem_revision_and_refuses_partial_errors() {
+    for failure in [false, true] {
+        let root = tempfile::tempdir().unwrap();
+        std::fs::create_dir_all(root.path().join("default/assets")).unwrap();
+        std::fs::write(root.path().join("default/assets/a"), b"stored asset").unwrap();
+        let storage = Arc::new(FsStorage::new(root.path().to_owned(), "assets".into()));
+        let probe = Arc::new(Probe::default());
+        let mut files = vec![
+            serde_json::json!({"path":"index.html","content":"<p>edited</p>"}),
+            serde_json::json!({"path":"a","src":"a"}),
+        ];
+        if failure {
+            files.push(serde_json::json!({"path":"missing","src":"absent"}));
+        }
+        let response = app(
+            Arc::clone(&probe),
+            Some(storage),
+            preparation::MAX_BODY_BYTES,
+        )
+        .oneshot(post_body(serde_json::json!({"files":files})))
+        .await
+        .unwrap();
+        if failure {
+            assert_eq!(response.status(), StatusCode::BAD_REQUEST);
+            assert_eq!(probe.hosting.load(Ordering::SeqCst), 0);
+            assert_eq!(probe.jobs.load(Ordering::SeqCst), 0);
+        } else {
+            assert_eq!(response.status(), StatusCode::OK);
+            let files = probe.files.lock().unwrap();
+            assert_eq!(files.len(), 2);
+            assert_eq!(
+                (&*files[0].path, &*files[0].content),
+                ("/index.html", b"<p>edited</p>".as_slice())
+            );
+            assert_eq!(
+                (&*files[1].path, &*files[1].content),
+                ("/a", b"stored asset".as_slice())
+            );
+            assert_eq!(probe.hosting.load(Ordering::SeqCst), 1);
+            assert_eq!(probe.jobs.load(Ordering::SeqCst), 1);
+        }
+    }
