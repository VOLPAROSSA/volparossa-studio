+#[tokio::test]
+async fn cancelling_a_pending_read_never_reaches_a_later_publication_step() {
+    let started = Arc::new(AtomicUsize::new(0));
+    let published = Arc::new(AtomicUsize::new(0));
+    let selected = plan(vec![file("index.html", None, Some("index"))]).unwrap();
+    let read_started = Arc::clone(&started);
+    let publish = Arc::clone(&published);
+    let task = tokio::spawn(async move {
+        let _files = selected
+            .materialize(deadline(), |_, _, _| {
+                read_started.fetch_add(1, Ordering::SeqCst);
+                std::future::pending::<ConnectorResult<Vec<u8>>>()
+            })
+            .await?;
+        publish.fetch_add(1, Ordering::SeqCst);
+        Ok::<_, ConnectorError>(())
+    });
+    for _ in 0..100 {
+        if started.load(Ordering::SeqCst) == 1 {
+            break;
+        }
+        tokio::task::yield_now().await;
+    }
+    assert_eq!(started.load(Ordering::SeqCst), 1);
+    task.abort();
+    assert!(task.await.unwrap_err().is_cancelled());
+    assert_eq!(published.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn every_asset_uses_one_original_deadline_and_expiry_prevents_later_reads() {
+    let selected = plan(vec![
+        file("index.html", None, Some("first")),
+        file("later", None, Some("second")),
+    ])
+    .unwrap();
+    let end = std::time::Instant::now() + std::time::Duration::from_millis(10);
+    let mut reads = 0;
+    let result = selected
+        .materialize(end, |_, _, original| {
+            assert_eq!(original, end);
+            reads += 1;
+            std::future::pending::<ConnectorResult<Vec<u8>>>()
+        })
+        .await;
+    assert!(result.is_err());
+    assert_eq!(reads, 1);
+}
