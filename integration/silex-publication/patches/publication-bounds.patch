+#[test]
+fn an_opened_regular_file_keeps_its_descriptor_when_the_name_is_replaced() {
+    let root = fixture();
+    let path = root.path().join("default/assets/nested/a");
+    let opened = linux::Opened::capture(File::open(&path).unwrap(), 100).unwrap();
+    fs::rename(&path, path.with_file_name("original")).unwrap();
+    fs::write(&path, b"replacement outside the captured inode").unwrap();
+    // A detectable ctime change may reject. In either case the replacement
+    // cannot redirect the pinned descriptor or supply the returned bytes.
+    if let Ok(bytes) = opened.read(deadline(), &AtomicBool::new(false)) {
+        assert_eq!(bytes, b"public asset");
+    }
+}
+
+#[tokio::test]
+async fn cancelled_blocking_jobs_keep_capacity_and_fds_until_cooperative_completion() {
+    let root = fixture();
+    let capacity = Arc::new(Semaphore::new(2));
+    let completed = Arc::new(AtomicUsize::new(0));
+    let mut releases = Vec::new();
+    for _ in 0..2 {
+        let (release, wait) = std::sync::mpsc::channel();
+        let (started, ready) = tokio::sync::oneshot::channel();
+        let (pool, done, path) = (
+            Arc::clone(&capacity),
+            Arc::clone(&completed),
+            root.path().join("default/assets/nested/a"),
+        );
+        let task = tokio::spawn(async move {
+            run(pool, deadline(), move |end, cancelled| {
+                let opened = linux::Opened::capture(File::open(path).unwrap(), 100).unwrap();
+                started.send(()).unwrap();
+                wait.recv_timeout(Duration::from_secs(3)).unwrap();
+                let result = opened.read(end, &cancelled);
+                assert!(result.is_err());
+                done.fetch_add(1, Ordering::SeqCst);
+                result
+            })
+            .await
+        });
+        tokio::time::timeout(Duration::from_secs(1), ready)
+            .await
+            .unwrap()
+            .unwrap();
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        releases.push(release);
+    }
+    assert_eq!(capacity.available_permits(), 0);
+    let starts = Arc::new(AtomicUsize::new(0));
+    let started = Arc::clone(&starts);
+    assert!(run(
+        Arc::clone(&capacity),
+        Instant::now() + Duration::from_millis(10),
+        move |_, _| {
+            started.fetch_add(1, Ordering::SeqCst);
+            Ok(Vec::new())
+        }
+    )
+    .await
+    .is_err());
+    assert_eq!(starts.load(Ordering::SeqCst), 0);
+    for release in releases {
+        release.send(()).unwrap();
+    }
+    tokio::time::timeout(Duration::from_secs(1), async {
+        while capacity.available_permits() != 2 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert_eq!(completed.load(Ordering::SeqCst), 2);
+}
